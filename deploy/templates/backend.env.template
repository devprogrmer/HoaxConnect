# HoaxConnect managed backend environment.
# The installer writes real values only to /etc/hoaxconnect/backend.env.
# Values marked GENERATED are never stored in Git.

NODE_ENV=production
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

POSTGRES_DB=hoaxconnect
POSTGRES_USER=hoaxconnect
POSTGRES_PASSWORD=GENERATED

DATABASE_URL=GENERATED
DATABASE_SSL=false

JWT_ISSUER=hoaxconnect-api
JWT_AUDIENCE=hoaxconnect-desktop
JWT_ACCESS_SECRET=GENERATED
REFRESH_TOKEN_PEPPER=GENERATED
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PROVIDER=none
PAYMENT_PROVIDER=none

CORS_ALLOWED_ORIGINS=CONFIGURED_ADMIN_HTTPS_ORIGIN
