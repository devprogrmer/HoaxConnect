NODE_ENV=production
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

POSTGRES_DB=hoaxconnect
POSTGRES_USER=hoaxconnect
POSTGRES_PASSWORD=generate-a-random-secret

DATABASE_URL=postgresql://hoaxconnect:generated-password@postgres:5432/hoaxconnect
DATABASE_SSL=false

JWT_ACCESS_SECRET=generate-at-least-64-random-characters
REFRESH_TOKEN_PEPPER=generate-at-least-64-random-characters
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PROVIDER=none
PAYMENT_PROVIDER=none

CORS_ALLOWED_ORIGINS=
