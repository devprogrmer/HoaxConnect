NODE_ENV=production
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
# Exact IPs of trusted reverse proxies; add the inspected Docker gateway for Nginx.
# Never use a wildcard or accept arbitrary X-Forwarded-For headers.
TRUSTED_PROXY_IPS=127.0.0.1,::1

POSTGRES_DB=hoaxconnect
POSTGRES_USER=hoaxconnect
POSTGRES_PASSWORD=generate-a-random-secret

DATABASE_URL=postgresql://hoaxconnect:generated-password@postgres:5432/hoaxconnect
DATABASE_SSL=false

JWT_ISSUER=hoaxconnect-api
JWT_AUDIENCE=hoaxconnect-desktop
JWT_ACCESS_SECRET=generate-at-least-64-random-characters
REFRESH_TOKEN_PEPPER=generate-at-least-64-random-characters
REFRESH_RECOVERY_ENCRYPTION_KEY=generate-a-random-32-byte-key-as-base64
REFRESH_RECOVERY_TTL_SECONDS=120
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PROVIDER=none
PAYMENT_PROVIDER=none

CORS_ALLOWED_ORIGINS=
ADMIN_ALLOWED_ORIGINS=https://hoaxnet.ir,https://www.hoaxnet.ir
ADMIN_SECRET_ENCRYPTION_KEY=generate-a-random-32-byte-key-as-base64
