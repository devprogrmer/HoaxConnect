{
  "name": "hoaxconnect",
  "private": true,
  "version": "0.3.10",
  "description": "Windows gaming network diagnostics and VPN client",
  "author": "HoaxConnect",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "build:ui": "tsc -b && vite build",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "tsc -p admin/tsconfig.json && vite build --config admin/vite.config.ts",
    "dist": "npm run build:ui && electron-builder",
    "dist:win": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "test:electron": "node --test electron/tests/*.test.cjs",
    "test:device-ui": "node --import ./backend/node_modules/tsx/dist/loader.mjs scripts/test-device-reporting.mjs",
    "test:update-artifacts": "node --test scripts/tests/verify-windows-update.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hoaxconnect.app",
    "productName": "HoaxConnect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.before-*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HoaxConnect-${version}-Setup.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HoaxConnect",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://hoaxnet.ir/updates/"
      }
    ],
    "extraResources": [
      {
        "from": "native-bin/HoaxTraffic.exe",
        "to": "traffic/HoaxTraffic.exe"
      }
    ]
  }
}
